{
  "name": "vehicletracking-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:vue": "npm run dev --",
    "build": "vite build",
    "build:vue": "npm run build --",
    "verify:vue": "node tests/visual/audit-vue.mjs",
    "lint": "oxlint && eslint \"**/*.vue\" --max-warnings 0",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:visual": "node tests/visual/capture.mjs",
    "test:e2e": "node tests/e2e/migration-smoke.mjs",
    "test:motion": "node --test tests/vehicleMotion.test.ts",
    "preview": "vite preview",
    "preview:vue": "npm run preview --"
  },
  "dependencies": {
    "@lucide/vue": "1.43.0",
    "leaflet": "^1.9.4",
    "vue": "3.5.43",
    "vue-router": "4.6.4",
    "vue3-toastify": "^0.2.9"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "2.5.1",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.0",
    "jsdom": "30.1.1",
    "oxlint": "^1.79.0",
    "playwright": "1.62.1",
    "prettier": "^3.9.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "^8.2.2",
    "vitest": "5.0.1",
    "vue-tsc": "3.3.11"
  }
}
