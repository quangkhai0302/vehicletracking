# Copy this file to .env.production on the server. Never commit the real file.

POSTGRES_DB=vehicle_tracking
POSTGRES_USER=vehicletracking
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# HERE credentials stay in the backend container and are never bundled into Vite.
HERE_API_KEY=REPLACE_WITH_YOUR_HERE_API_KEY
HERE_ROUTING_ENABLED=true
HERE_TRAFFIC_ENABLED=true

HERE_ROUTING_BASE_URL=https://router.hereapi.com
HERE_TRAFFIC_BASE_URL=https://data.traffic.hereapi.com
HERE_CONNECT_TIMEOUT_MS=2000
HERE_READ_TIMEOUT_MS=5000
HERE_ROUTING_CONNECT_TIMEOUT_MS=2000
HERE_ROUTING_READ_TIMEOUT_MS=10000
TRAFFIC_CACHE_TTL_SECONDS=60
TRAFFIC_STALE_TTL_SECONDS=300

REROUTE_DELAY_PERCENT=30
REROUTE_DELAY_SECONDS=600
REROUTE_COOLDOWN_SECONDS=300

# Use :80 while testing by public IP. Change to your domain after DNS is ready.
SITE_ADDRESS=:80
APP_CORS_ALLOWED_ORIGINS=http://localhost
TZ=Asia/Ho_Chi_Minh
JAVA_TOOL_OPTIONS=-Xms128m -Xmx768m
