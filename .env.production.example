# Copy this file to .env.production on the server. Never commit the real file.

POSTGRES_DB=vehicle_tracking
POSTGRES_USER=vehicletracking
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# HERE credentials stay in the backend container and are never bundled into Vite.
HERE_API_KEY=REPLACE_WITH_YOUR_HERE_API_KEY
HERE_ROUTING_ENABLED=true
HERE_TRAFFIC_ENABLED=true

HERE_ROUTING_BASE_URL=https://router.hereapi.com
HERE_TRAFFIC_BASE_URL=https://data.traffic.hereapi.com
HERE_CONNECT_TIMEOUT_MS=2000
HERE_READ_TIMEOUT_MS=5000
HERE_ROUTING_CONNECT_TIMEOUT_MS=2000
HERE_ROUTING_READ_TIMEOUT_MS=10000
TRAFFIC_CACHE_TTL_SECONDS=60
TRAFFIC_STALE_TTL_SECONDS=300

REROUTE_DELAY_PERCENT=30
REROUTE_DELAY_SECONDS=600
REROUTE_COOLDOWN_SECONDS=300

# Off-route alert detector defaults; tune only after validating GPS accuracy and route geometry.
OFFROUTE_ENABLED=true
OFFROUTE_THRESHOLD_METERS=150
OFFROUTE_GRACE_PERIOD_SECONDS=30
OFFROUTE_CONSECUTIVE_SAMPLES=3

# Bootstrap one admin account on first startup. Never commit the real password.
AUTH_SECURITY_ENABLED=true
AUTH_BOOTSTRAP_ADMIN_USERNAME=admin
AUTH_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# GPS overspeed reporting threshold. Consecutive samples above this limit count as one event.
REPORT_DEFAULT_SPEED_LIMIT_KMH=80
REPORT_MAX_RANGE_DAYS=366

# Keep true for HTTPS production. Set false only for temporary IP/HTTP demos
# with non-production credentials and data.
SESSION_COOKIE_SECURE=true

# Production must use a DNS name so Caddy can issue HTTPS and the secure session cookie works.
# Point DNS and ports 80/443 at this host before starting compose.production.yaml.
SITE_ADDRESS=tracking.example.com
APP_CORS_ALLOWED_ORIGINS=https://tracking.example.com
TZ=Asia/Ho_Chi_Minh
JAVA_TOOL_OPTIONS=-Xms128m -Xmx768m
